{
  "expo": {
    "name": "Glucosapp Mobile",
    "slug": "glucosapp-mobile",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "scheme": "glucosapp",
    "platforms": ["ios", "android", "web"],
    "orientation": "portrait",
    "newArchEnabled": false,
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./android/app/src/main/res/mipmap-xxxhdpi/ic_launcher.webp",
          "color": "#2563EB",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Glucosapp to access your camera to scan food items."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Glucosapp to save scanned images to your photo library.",
          "savePhotosPermission": "Allow Glucosapp to save scanned images to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ],
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "android": {
      "package": "com.glucosapp.mobile",
      "permissions": ["POST_NOTIFICATIONS"],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "glucosapp",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.glucosapp.mobile",
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": ["glucosapp"]
          }
        ],
        "NFCReaderUsageDescription": "Glucosapp necesita acceso a NFC para leer datos de tu sensor FreeStyle Libre.",
        "UIBackgroundModes": ["remote-notification"]
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.developer.nfc.readersession.formats": ["TAG"]
      }
    }
  }
}
