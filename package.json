{
  "name": "glucosapp",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "husky install",
    "dev": "sh -c 'docker compose up -d db >/dev/null 2>&1 || echo \"[dev] No se pudo iniciar db con docker compose; continúo con backend/web.\"; turbo run dev --filter=backend... --filter=web...'",
    "dev:all": "docker compose up -d db && turbo run dev",
    "dev:mobile": "pnpm -C apps/mobile dev",
    "dev:mobile:ios": "pnpm -C apps/mobile ios",
    "dev:mobile:android": "pnpm -C apps/mobile android",
    "dev:mobile:web": "pnpm -C apps/mobile web",
    "db:start": "docker compose up -d db",
    "db:stop": "docker compose stop db",
    "docker:dev": "docker compose up --build",
    "docker:down": "docker compose down",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "node ./scripts/run-tests-with-summary.mjs",
    "test:coverage": "turbo run test:coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.4.0",
    "@commitlint/config-conventional": "^19.4.0",
    "@types/node": "20",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "^4.1.0",
    "expo-module-scripts": "^55.0.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "tsup": "^8.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.6.2"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}
